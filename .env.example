# Copy to .env.local for local development. Never commit real values.
# Production values live only in Vercel environment variables.

# Required at boot
WA_ACCESS_TOKEN=

# Required where used
PHONE_NUMBER_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional, minutes. Defaults to 1440 (24 hours) when unset.
WA_CUSTOMER_WINDOW_MINUTES=
